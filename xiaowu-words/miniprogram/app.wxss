page { background: #f8f6ef; color: #293b32; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.6; }
view, text, button, input, textarea { box-sizing: border-box; }
button { font-size: 29rpx; line-height: 1.5; border-radius: 24rpx; padding: 24rpx 28rpx; margin: 0; font-weight: 600; }
button::after { border: none; }
button[disabled] { opacity: .45; }
button.primary { background: #28664c; color: #fff; }
button.secondary { background: #e7eee5; color: #28563f; }
button.ghost { background: #fff; color: #365b46; border: 2rpx solid #dce5d9; }
button.small { padding: 14rpx 22rpx; font-size: 25rpx; border-radius: 18rpx; }
.page { padding: 32rpx 32rpx 72rpx; padding-bottom: calc(72rpx + env(safe-area-inset-bottom)); }
.eyebrow { font-size: 22rpx; color: #6b7e68; letter-spacing: 4rpx; font-weight: 600; }
.title { font-size: 48rpx; font-weight: 700; line-height: 1.3; margin: 12rpx 0 16rpx; }
.subtitle, .muted { color: #718074; }
.subtitle { font-size: 27rpx; }
.card { background: #fff; border: 2rpx solid #ebece1; border-radius: 30rpx; padding: 28rpx; margin-top: 24rpx; }
.row { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.section { font-size: 30rpx; font-weight: 650; margin: 32rpx 0 16rpx; }
.stack > button { margin-top: 18rpx; }
.hint { font-size: 24rpx; color: #788274; line-height: 1.7; margin-top: 16rpx; }
.notice { padding: 20rpx 24rpx; background: #ecf0e3; color: #596c4c; border-radius: 20rpx; font-size: 24rpx; margin: 20rpx 0; }
.error { background: #fff0e8; color: #95502c; }
.empty { text-align: center; padding: 56rpx 28rpx; color: #6a796c; }
.empty-title { color: #344d3c; font-size: 32rpx; font-weight: 600; margin-bottom: 12rpx; }
.field-label { display: block; font-size: 25rpx; color: #576c5d; margin: 24rpx 0 12rpx; }
input, textarea, .picker { width: 100%; background: #f4f5ef; border: 2rpx solid #e5e9df; border-radius: 20rpx; padding: 22rpx; font-size: 29rpx; color: #293b32; }
input { height: 90rpx; }
textarea { min-height: 160rpx; }
.badge { border-radius: 12rpx; background: #edf3e9; color: #3f7551; padding: 4rpx 14rpx; font-size: 22rpx; }
.loading { padding: 60rpx; text-align: center; color: #718074; }
.stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 24rpx; }
.stat { background: #fff; padding: 24rpx 10rpx; border-radius: 24rpx; text-align: center; border: 2rpx solid #ebece1; }
.stat-value { font-size: 44rpx; line-height: 1.2; font-weight: 700; }
.stat-label { font-size: 22rpx; color: #748071; margin-top: 10rpx; }
.link { color: #28664c; font-size: 25rpx; padding: 14rpx 0; }
