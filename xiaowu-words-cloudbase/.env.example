# Only configure these in the HTTP cloud function's server environment variables.
# Do not put API keys in VITE_* variables or commit them to GitHub.
CLOUDBASE_ENV_ID=YOUR_ENV_ID
CLOUDBASE_APIKEY=YOUR_SERVER_SIDE_SERVICE_ROLE_API_KEY
FAMILY_SETUP_CODE=YOUR_RANDOM_FAMILY_ADMIN_CODE_AT_LEAST_32_CHARACTERS
# Optional: set after obtaining the HTTPS gateway URL, no trailing slash.
APP_ORIGIN=
PORT=9000
